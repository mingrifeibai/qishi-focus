{
  "name": "qishi-focus",
  "productName": "栖时",
  "version": "1.1.0",
  "description": "栖时 · 把时间留给重要的事",
  "author": "Qishi",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && npm run build:electron",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --external:electron --format=cjs --outfile=dist-electron/main.cjs && esbuild electron/preload.ts --bundle --platform=node --external:electron --format=cjs --outfile=dist-electron/preload.cjs",
    "start": "electron .",
    "test": "tsx --test tests/core.test.ts",
    "test:e2e": "playwright test",
    "package": "npm run build && electron-builder --win nsis --x64 --publish never",
    "package:portable": "npm run build && electron-builder --win portable --x64 --publish never",
    "verify:installer": "node scripts/verify-installer.mjs",
    "format": "prettier --write src electron tests scripts *.json *.ts *.html *.md",
    "check": "tsc --noEmit"
  },
  "build": {
    "appId": "studio.qishi.focus",
    "productName": "栖时",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "assets/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "artifactName": "Qishi-Setup-${version}-x64.exe",
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "栖时",
      "uninstallDisplayName": "栖时",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052",
      "differentialPackage": false
    },
    "portable": {
      "artifactName": "Qishi-${version}.exe"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
